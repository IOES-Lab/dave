#ifndef GZ_SENSORS_SONAR_COMPUTE_WGPU_HH_
#define GZ_SENSORS_SONAR_COMPUTE_WGPU_HH_

#include <complex>
#include <memory>
#include <string>
#include <vector>

#include <opencv2/core.hpp>

namespace gz
{
namespace sensors
{

// Per-frame data passed into the sonar pipeline
// (directly mirrors Gazebo depth + normal render outputs)
struct SonarComputeInput
{
  // Rendered images (row = ray, col = beam)
  const cv::Mat * depthImage        = nullptr;   // distance [m]
  const cv::Mat * normalImage       = nullptr;   // surface normals
  const cv::Mat * reflectivityImage = nullptr;   // μ ∈ [0,1]

  // Beam correction matrix W (applied after scattering)
  float ** beamCorrector    = nullptr;
  float    beamCorrectorSum = 1.0f;

  // Optional windowing (used before IFFT if needed)
  float * window = nullptr;

  // Dimensions
  int nBeams = 0;
  int nRays  = 0;
  int nFreq  = 0;
  int raySkips = 0;

  // Acoustic parameters (from sonar model)
  double soundSpeed  = 1500.0;
  double maxDistance = 60.0;
  double sourceLevel = 220.0;
  double attenuation = 0.0;
  double bandwidth   = 2950.0;

  // Sensor geometry
  float sensorGain = 1.0f;
  float hFOV = 1.5708f;   // 90°
  float vFOV = 0.3491f;   // 20°

  // Frame-based seed (used for speckle / randomness on GPU)
  uint64_t frameIndex = 0;
  uint64_t seed       = 42;
};

// Output: complex spectrum per beam
// (frequency-domain before optional IFFT → range profile)
struct SonarComputeOutput
{
  int nBeams = 0;
  int nFreq  = 0;

  // Layout: [beam * nFreq + freq]
  std::vector<std::complex<float>> beamSpectrum;

  double computeMicros = 0.0;

  inline std::complex<float> & At(int b, int f)
  {
    return beamSpectrum[static_cast<size_t>(b) * nFreq + f];
  }
};

// Backend interface
// Allows runtime switching: CPU / CUDA / WGPU
class SonarComputeBackend
{
public:
  virtual ~SonarComputeBackend() = default;

  // "wgpu", "cuda", "cpu"
  virtual const char * Name() const = 0;

  // Allocate GPU / buffers etc.
  virtual bool Initialize(const SonarComputeInput & input) = 0;

  // Run one frame
  virtual bool Compute(
    const SonarComputeInput & input,
    SonarComputeOutput & output) = 0;
};

// Factory (used by sensor plugin)
std::unique_ptr<SonarComputeBackend>
CreateComputeBackend(const std::string & name);

// WGPU backend (Rust + WGSL)
// Pipeline follows Choi et al. sonar model:
//
//   1. Backscatter     → amplitude + phase (Eq.14, Eq.8)
//   2. Beam correction → W·P
//   3. FFT             → frequency → time (range)
//
// Falls back to CPU if GPU is unavailable or fails at runtime.
class WgpuComputeBackend : public SonarComputeBackend
{
public:
  WgpuComputeBackend()  = default;
  ~WgpuComputeBackend() = default;

  const char * Name() const override;

  bool Initialize(const SonarComputeInput & input) override;

  bool Compute(
    const SonarComputeInput & input,
    SonarComputeOutput & output) override;

private:
  bool initialized_  = false;
  bool gpuAvailable_ = false;

  // Used when GPU fails mid-run (device lost, bad config, etc.)
  std::unique_ptr<SonarComputeBackend> cpuFallback_;
};

}  // namespace sensors
}  // namespace gz

#endif